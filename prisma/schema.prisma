generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String                     @id @default(uuid()) @db.Uuid
  firstName           String?                    @db.VarChar(50)
  lastName            String?                    @db.VarChar(50)
  email               String                     @unique @db.VarChar(255)
  phone               String?                    @unique @db.VarChar(20)
  profileImage        String?
  dateOfBirth         DateTime?                  @db.Date
  country             String?                    @db.VarChar(100)
  state               String?                    @db.VarChar(100)
  city                String?                    @db.VarChar(100)
  timezone            String?                    @db.VarChar(50)
  language            String?                    @default("en") @db.VarChar(10)
  password            String?
  provider            AuthProvider               @default(EMAIL)
  providerId          String?                    @db.VarChar(255)
  role                Role                       @default(USER)
  isEmailVerified     Boolean                    @default(false)
  isActive            Boolean                    @default(true)
  isBlocked           Boolean                    @default(false)
  isDeleted           Boolean                    @default(false)
  failedLoginAttempts Int                        @default(0) @db.SmallInt
  lockUntil           DateTime?                  @db.Timestamptz(6)
  refreshTokenVersion Int                        @default(1)
  lastLogin           DateTime?                  @db.Timestamptz(6)
  deletedAt           DateTime?                  @db.Timestamptz(6)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(6)
  createdBy           String?                    @db.Uuid
  updatedBy           String?                    @db.Uuid
  orders              Order[]
  otps                Otp[]
  subscriptions       Subscription[]
  subNotifications    SubscriptionNotification[]
  memberships         Membership[]
  pointsWallet        PointsWallet?
  wishlistItems       WishlistItem[]
  // Shopping cart stored as a JSON array on the user (login-only cart).
  // Shape: { id, productId, variant, quantity, unitPrice, meta }[]
  cart                Json                       @default("[]")
  // Saved addresses stored as a JSON array on the user (no separate table).
  // Shape: { id, addressType, fullName, addressLine1, addressLine2?, city, state,
  //   postalCode, country, isDefault }[] — exactly one item has isDefault=true.
  addresses           Json                       @default("[]")
  // GDPR consent flags: { marketingEmails, promotionalNotifications, analyticsCookies, personalization }.
  // Missing keys fall back to defaults in lib/gdpr.ts.
  consent             Json                       @default("{}")

  @@unique([provider, providerId])
  @@index([email])
  @@index([role])
  @@index([isActive, isDeleted])
}

model Otp {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  otp       String   @db.VarChar(255)
  type      OtpType
  expiresAt DateTime @db.Timestamptz(6)
  verified  Boolean  @default(false)
  attempts  Int      @default(0) @db.SmallInt
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  totalAmount    Decimal     @db.Decimal(10, 2)
  // Price breakdown captured at checkout (for the admin order detail view).
  subtotal       Decimal     @default(0) @db.Decimal(10, 2)
  shippingFee    Decimal     @default(0) @db.Decimal(10, 2)
  tax            Decimal     @default(0) @db.Decimal(10, 2)
  discount       Decimal     @default(0) @db.Decimal(10, 2)
  // How the customer paid: points redeemed + method (CARD | POINTS | MIXED).
  pointsRedeemed Int         @default(0)
  paymentMethod  String      @default("CARD") @db.VarChar(20)
  // Snapshot of the delivery/contact details entered at checkout.
  shippingInfo   Json?
  status         OrderStatus @default(PENDING)
  trackingNumber String?     @db.VarChar(100)
  // Cancellation audit; points redeemed on the order are refunded to the wallet on cancel.
  cancelledAt    DateTime?   @db.Timestamptz(6)
  cancelReason   String?     @db.VarChar(255)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  productId  String   @db.Uuid
  // Snapshot of the chosen variant/color at purchase time (variants now live in Product.variants JSON)
  variantSku String?  @db.VarChar(100)
  colorName  String?  @db.VarChar(100)
  quantity   Int
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model Product {
  id                String                    @id @default(uuid()) @db.Uuid
  name              String                    @db.VarChar(255)
  slug              String                    @unique @db.VarChar(255)
  sku               String?                   @unique @db.VarChar(100)
  shortDescription  String?
  description       String?
  country           String?                   @db.VarChar(100)
  status            ProductStatus             @default(DRAFT)
  isFeatured        Boolean                   @default(false)
  isBestSeller      Boolean                   @default(false)
  isTrending        Boolean                   @default(false)
  isNewArrival      Boolean                   @default(false)
  /// Curated star rating shown on the product detail page, 1-5 (halves allowed).
  /// NULL means "not set": the page falls back to the average of the published ProductReview
  /// rows, which is what it showed before this column existed.
  rating            Float?
  /// Retired: the detail page no longer prints a review count beside the stars, and the admin
  /// form no longer offers the field, so nothing reads or writes this column. Kept rather than
  /// dropped because it still holds values entered before the change — delete the column and
  /// this line together if the count is never coming back.
  reviewCount       Int?
  // All variants (and their nested color variants, specifications, images) are stored as JSON.
  // Shape: Variant[] where each Variant = { id, variantName, sku, description, pros[], cons[],
  //   specifications: { title, value }[], colorVariants: ColorVariant[] }
  // ColorVariant = { id, colorName, colorCode, price, salePrice, swatchImage, hoverImage,
  //   galleryImages: { url, publicId, type?: 'image'|'video', isPrimary, order }[] }
  // `type` distinguishes gallery videos (Blushing Blooms) from stills. Rows created before it
  // existed omit it entirely — read gallery media through lib/media.ts, never `type` directly.
  variants          Json                      @default("[]")
  createdAt         DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(6)
  // Fixed-category system: one of the six CategoryType + a Subcategory within it.
  categoryType      CategoryType?
  subcategoryId     String?                   @db.Uuid
  orderItems        OrderItem[]
  subscriptions     Subscription[]
  occasions         OccasionProduct[]
  subscriptionPlans SubscriptionPlanProduct[]
  subcategory       Subcategory?              @relation(fields: [subcategoryId], references: [id])
  stockLevels       StockLevel[]
  reviews           ProductReview[]
  wishlistItems     WishlistItem[]

  @@index([slug])
  @@index([status])
  @@index([subcategoryId])
  @@index([categoryType])
}

/// Video banners shown in the storefront hero/banner section. Each banner is a single video media.
model Banner {
  id            String   @id @default(uuid()) @db.Uuid
  title         String?  @db.VarChar(255)
  subheading    String?  @db.VarChar(255)
  description   String?
  /// Hex colours for the copy overlaid on this banner's video, one per text element so the
  /// heading, subheading and description can be styled independently. Null on any of them
  /// keeps the white the storefront used before these were configurable.
  titleColor       String?  @db.VarChar(7)
  subheadingColor  String?  @db.VarChar(7)
  descriptionColor String?  @db.VarChar(7)
  videoUrl      String
  videoPublicId String?  @db.VarChar(255)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@index([isActive, sortOrder])
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  FACEBOOK
  GITHUB
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OtpType {
  EMAIL_VERIFY
  PASSWORD_RESET
  PHONE_VERIFY
}

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET
  CHANGE_EMAIL
  TWO_FACTOR
}

/// Email-based one-time passwords, used BEFORE a User row exists (e.g. registration).
/// Reusable for password reset / change email / 2FA via `purpose`. The `otp` column
/// stores a bcrypt hash of the 6-digit code — the plaintext is only ever emailed.
model EmailOTP {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @db.VarChar(255)
  otp       String     @db.VarChar(255)
  purpose   OtpPurpose @default(REGISTER)
  expiresAt DateTime   @db.Timestamptz(6)
  isUsed    Boolean    @default(false)
  attempts  Int        @default(0) @db.SmallInt
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)

  @@index([email, purpose])
  @@index([expiresAt])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

enum OfferStatus {
  ACTIVE
  INACTIVE
}

enum PromotionType {
  FESTIVAL
  WEEKEND
  FLASH_SALE
  SEASON_SALE
  BIRTHDAY
  ANNIVERSARY
  CHRISTMAS
  NEW_YEAR
  DIWALI
  EID
  BLACK_FRIDAY
  CYBER_MONDAY
  CUSTOM
}

model Coupon {
  id                   String        @id @default(uuid()) @db.Uuid
  code                 String        @unique @db.VarChar(50)
  name                 String        @db.VarChar(255)
  description          String?
  type                 DiscountType  @default(PERCENTAGE)
  discountValue        Decimal       @db.Decimal(10, 2)
  maxDiscount          Decimal?      @db.Decimal(10, 2)
  minOrderAmount       Decimal       @default(0) @db.Decimal(10, 2)
  startDate            DateTime      @db.Timestamptz(6)
  endDate              DateTime      @db.Timestamptz(6)
  usageLimit           Int?
  usagePerCustomer     Int?
  currentUsage         Int           @default(0)
  applicableCategories String[]      @db.Uuid
  applicableProducts   String[]      @db.Uuid
  excludedProducts     String[]      @db.Uuid
  excludedCategories   String[]      @db.Uuid
  autoApply            Boolean       @default(false)
  freeDelivery         Boolean       @default(false)
  status               OfferStatus   @default(ACTIVE)
  priority             Int           @default(0)
  createdBy            String?       @db.Uuid
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(6)
  usages               CouponUsage[]

  @@index([code])
  @@index([status])
  @@index([startDate, endDate])
  @@index([autoApply])
}

model CouponUsage {
  id       String   @id @default(uuid()) @db.Uuid
  couponId String   @db.Uuid
  userId   String?  @db.Uuid
  orderId  String?  @db.Uuid
  discount Decimal  @db.Decimal(10, 2)
  usedAt   DateTime @default(now()) @db.Timestamptz(6)
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([couponId, userId])
}

model Promotion {
  id                   String        @id @default(uuid()) @db.Uuid
  title                String        @db.VarChar(255)
  description          String?
  promotionType        PromotionType @default(CUSTOM)
  banner               String?
  bannerPublicId       String?       @db.VarChar(255)
  startDate            DateTime      @db.Timestamptz(6)
  endDate              DateTime      @db.Timestamptz(6)
  discountType         DiscountType  @default(PERCENTAGE)
  discountValue        Decimal       @db.Decimal(10, 2)
  maxDiscount          Decimal?      @db.Decimal(10, 2)
  applicableCategories String[]      @db.Uuid
  applicableProducts   String[]      @db.Uuid
  excludedProducts     String[]      @db.Uuid
  excludedCategories   String[]      @db.Uuid
  autoApply            Boolean       @default(true)
  status               OfferStatus   @default(ACTIVE)
  priority             Int           @default(0)
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@index([promotionType])
  @@index([startDate, endDate])
}

model FreeDeliveryCampaign {
  id                   String      @id @default(uuid()) @db.Uuid
  name                 String      @db.VarChar(255)
  minOrderAmount       Decimal     @default(0) @db.Decimal(10, 2)
  startDate            DateTime    @db.Timestamptz(6)
  endDate              DateTime    @db.Timestamptz(6)
  applicableCategories String[]    @db.Uuid
  applicableProducts   String[]    @db.Uuid
  status               OfferStatus @default(ACTIVE)
  priority             Int         @default(0)
  createdAt            DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@index([startDate, endDate])
}

// ─────────────────────────── Subscriptions (Subscribe & Save) ───────────────────────────

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum SubscriptionFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  EVERY_X_DAYS
  EVERY_X_WEEKS
  EVERY_X_MONTHS
  SPECIFIC_WEEKDAY
  SPECIFIC_MONTH_DATE
}

enum DeliveryStatus {
  SCHEDULED
  SKIPPED
  DELIVERED
  CANCELLED
}

enum SubscriptionAction {
  CREATED
  PAUSED
  RESUMED
  SKIPPED
  CANCELLED
  UPDATED
  COMPLETED
  DELIVERY_GENERATED
}

enum SubNotificationType {
  SUBSCRIPTION_CREATED
  UPCOMING_DELIVERY
  DELIVERY_TODAY
  SUBSCRIPTION_PAUSED
  SUBSCRIPTION_RESUMED
  SUBSCRIPTION_CANCELLED
  DELIVERY_SKIPPED
}

/// A customer's recurring subscription to a product. Recurrence (plan + schedule) is
/// embedded here; concrete delivery instances live in SubscriptionDelivery.
model Subscription {
  id               String                     @id @default(uuid()) @db.Uuid
  userId           String                     @db.Uuid
  productId        String                     @db.Uuid
  variantId        String?                    @db.VarChar(100)
  colorId          String?                    @db.VarChar(100)
  // Display snapshot (live product data stays in Product.variants JSON)
  productName      String                     @db.VarChar(255)
  productImage     String?
  variantLabel     String?                    @db.VarChar(255)
  quantity         Int                        @default(1)
  unitPrice        Decimal                    @db.Decimal(10, 2)
  discountPercent  Int                        @default(0)
  // Recurrence config
  frequency        SubscriptionFrequency
  intervalCount    Int                        @default(1)
  weekday          Int?                       @db.SmallInt
  monthDate        Int?                       @db.SmallInt
  // Duration (totalDeliveries null = unlimited)
  totalDeliveries  Int?
  startDate        DateTime                   @db.Date
  endDate          DateTime?                  @db.Date
  nextDeliveryDate DateTime?                  @db.Date
  status           SubscriptionStatus         @default(ACTIVE)
  pausedAt         DateTime?                  @db.Timestamptz(6)
  resumeDate       DateTime?                  @db.Date
  cancelledAt      DateTime?                  @db.Timestamptz(6)
  cancelReason     String?
  deliveryAddress  Json
  createdAt        DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(6)
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  deliveries       SubscriptionDelivery[]
  history          SubscriptionHistory[]
  notifications    SubscriptionNotification[]

  @@index([userId, status])
  @@index([status, nextDeliveryDate])
  @@index([productId])
}

/// One concrete scheduled delivery within a subscription.
model SubscriptionDelivery {
  id             String         @id @default(uuid()) @db.Uuid
  subscriptionId String         @db.Uuid
  sequence       Int
  scheduledDate  DateTime       @db.Date
  status         DeliveryStatus @default(SCHEDULED)
  orderId        String?        @db.Uuid
  deliveredAt    DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, sequence])
  @@index([subscriptionId, scheduledDate])
  @@index([status, scheduledDate])
}

/// Immutable lifecycle audit trail for a subscription.
model SubscriptionHistory {
  id             String             @id @default(uuid()) @db.Uuid
  subscriptionId String             @db.Uuid
  action         SubscriptionAction
  note           String?
  metadata       Json?
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  subscription   Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
}

/// In-app notifications tied to subscription events.
model SubscriptionNotification {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  subscriptionId String?             @db.Uuid
  type           SubNotificationType
  title          String              @db.VarChar(255)
  body           String?
  isRead         Boolean             @default(false)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([subscriptionId])
}

// ─────────────────────────── M05: Gift add-ons & greeting cards (global catalogs) ───────────────────────────

/// Global gift add-ons (chocolate, teddy, balloons…) selectable on the product page.
model AddOn {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  image         String?
  imagePublicId String?  @db.VarChar(255)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@index([isActive, sortOrder])
}

/// Greeting-card templates the customer can pick + write a message on.
model GreetingCardTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  image     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([isActive, sortOrder])
}

/// A merchandising section on the home page (e.g. "Birthday Gifts") with a
/// hand-picked set of existing products. Products are referenced, never copied.
model Occasion {
  id           String            @id @default(uuid()) @db.Uuid
  title        String            @db.VarChar(100)
  slug         String            @unique @db.VarChar(255)
  subtitle     String            @db.VarChar(250)
  description  String?
  bannerImage  String?
  /// Optional override; falls back to /occasion/[slug].
  buttonText   String?           @db.VarChar(50)
  buttonLink   String?           @db.VarChar(255)
  /// The single collection promoted above New Arrivals on the home page.
  isFeatured   Boolean           @default(false)
  /// Singleton guard: exactly one Occasion may exist. `@unique` on a column that always
  /// defaults to true means a second INSERT violates the constraint, so the limit holds even
  /// if two admins submit at once — the API check alone would race.
  singleton    Boolean           @unique @default(true)
  displayOrder Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)
  products     OccasionProduct[]

  @@index([isActive, displayOrder])
  @@index([isActive, isFeatured, displayOrder])
  @@index([slug])
}

/// Join table: one Occasion ↔ many Products (a Product may appear in many Occasions).
/// Cascades delete the mapping rows only — Products are never deleted.
model OccasionProduct {
  id         String   @id @default(uuid()) @db.Uuid
  occasionId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // DB-level guarantee against duplicate product selection within an occasion.
  @@unique([occasionId, productId])
  @@index([occasionId])
  @@index([productId])
}

/// A "why choose us" feature card (icon + title + description + bullet points + CTA),
/// managed from the admin panel and rendered on the storefront.
/// The three permanent subscription tiers. Rows are seeded once and never added/deleted.
enum PlanType {
  SILVER
  GOLD
  PLATINUM
}

/// A fixed subscription plan (Silver / Gold / Platinum). Exactly three rows exist —
/// `planType` is unique so the set can never grow. Only the single `featurePoints`
/// number, the validity, and the applicable products are editable; the plan name
/// (planType) is read-only.
model SubscriptionPlan {
  id             String                    @id @default(uuid()) @db.Uuid
  planType       PlanType                  @unique
  /// A single number for the plan (e.g. loyalty/feature points). Exactly one per plan.
  featurePoints  Int                       @default(0)
  /// Plan price (QAR).
  price          Decimal                   @default(0) @db.Decimal(10, 2)
  validityYears  Int                       @default(0)
  validityMonths Int                       @default(0)
  validityDays   Int                       @default(0)
  /// Admin can enable/disable a plan for purchase without deleting it.
  isActive       Boolean                   @default(true)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(6)
  products       SubscriptionPlanProduct[]
  memberships    Membership[]
}

/// Enums for the membership + points-wallet system (distinct from recurring delivery Subscriptions).
enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum WalletTxnType {
  SUBSCRIPTION_PURCHASED
  POINTS_CREDITED
  POINTS_REDEEMED
  POINTS_EXPIRED
  ADMIN_ADJUSTMENT
  REFUND
}

/// A user's PURCHASED membership plan (Silver/Gold/Platinum). Separate from the recurring
/// product-delivery `Subscription`. Points live in the user's PointsWallet, not here.
model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  planId         String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  startsAt       DateTime         @db.Timestamptz(6)
  expiresAt      DateTime         @db.Timestamptz(6)
  /// Points this purchase granted (immutable record; the spendable balance is on PointsWallet).
  pointsCredited Int              @default(0)
  pricePaid      Decimal          @default(0) @db.Decimal(10, 2)
  /// Simulated-payment record (swap the gateway later without touching this shape).
  paymentGateway String           @default("SIMULATED") @db.VarChar(30)
  paymentMethod  String           @default("DEVELOPMENT") @db.VarChar(30)
  paymentStatus  String           @default("SUCCESS") @db.VarChar(20)
  paymentTxnId   String?          @db.VarChar(100)
  /// Anti-replay: a client-supplied key makes the "simulate payment" call idempotent.
  idempotencyKey String?          @unique @db.VarChar(100)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([expiresAt])
}

/// One points wallet per user — the single source of truth for the spendable balance.
/// `availablePoints` is the concurrency-controlled balance; the aggregates are lifetime totals.
model PointsWallet {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @unique @db.Uuid
  totalEarned     Int                 @default(0)
  usedPoints      Int                 @default(0)
  expiredPoints   Int                 @default(0)
  availablePoints Int                 @default(0)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    WalletTransaction[]
}

/// Immutable ledger of every wallet movement (before/change/after + reason + reference).
model WalletTransaction {
  id            String        @id @default(uuid()) @db.Uuid
  walletId      String        @db.Uuid
  type          WalletTxnType
  beforeBalance Int
  change        Int
  afterBalance  Int
  reason        String        @db.VarChar(255)
  /// Free-form reference to the source (membership id, order id, etc.).
  reference     String?       @db.VarChar(100)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  wallet        PointsWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([walletId, createdAt])
}

/// Join: which existing Products a SubscriptionPlan applies to (referenced, never
/// copied). A Product may belong to many plans; mapping rows cascade, Products never do.
model SubscriptionPlanProduct {
  id                 String           @id @default(uuid()) @db.Uuid
  subscriptionPlanId String           @db.Uuid
  productId          String           @db.Uuid
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  plan               SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([subscriptionPlanId, productId])
  @@index([subscriptionPlanId])
  @@index([productId])
}

/// Delivery charge calculation type.
enum ChargeType {
  FIXED
  PERCENTAGE
}

/// Global delivery-charge configuration — a singleton. The unique `singleton` column
/// (always true) means the table can never hold more than one row, even if a duplicate
/// insert bypasses the API. Only this one record is ever read/updated.
model DeliveryCharge {
  id         String     @id @default(uuid()) @db.Uuid
  chargeType ChargeType @default(FIXED)
  value      Decimal    @db.Decimal(10, 2)
  /// Master switch. When false no shipping is charged at all, whatever `value` says —
  /// so the figure survives being switched back on rather than having to be retyped.
  isActive   Boolean    @default(true)
  /// Orders at or above this subtotal ship free. 0 disables the threshold entirely.
  freeAbove  Decimal    @default(0) @db.Decimal(10, 2)
  singleton  Boolean    @unique @default(true)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(6)
}

/// Appearance of the storefront promotion ticker pinned to the bottom of the home banner.
/// A singleton — there is one bar — enforced by the unique `singleton` column, the same way
/// DeliveryCharge and WelcomePopup do it. The defaults reproduce the colours that were
/// hardcoded in components/PromotionBar.tsx, so an empty table renders the existing design.
model PromotionBarSetting {
  id        String   @id @default(uuid()) @db.Uuid
  barColor  String   @default("#b0aca7") @db.VarChar(7)
  textColor String   @default("#ffffff") @db.VarChar(7)
  singleton Boolean  @unique @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

/// Storefront welcome popup — a singleton config (heading + description). The unique
/// `singleton` column (always true) guarantees the table can never hold more than one row.
model WelcomePopup {
  id          String   @id @default(uuid()) @db.Uuid
  heading     String   @db.VarChar(100)
  description String   @db.VarChar(400)
  singleton   Boolean  @unique @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
}

/// A product review, written by the admin on a customer's behalf.
///
/// Deliberately not tied to a User or an Order: these are curated testimonials the shop
/// enters from emails, cards and social posts, not self-service submissions. `authorName` is
/// therefore free text rather than a relation.
model ProductReview {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @db.Uuid
  authorName String  @db.VarChar(80)
  /// Whole stars, 1–5. Enforced by a CHECK constraint as well as by validation.
  rating     Int
  title      String? @db.VarChar(120)
  content    String
  /// Hidden reviews stay in the table so they can be restored — never deleted to hide them.
  isPublished Boolean @default(true)
  /// When the review was written, which is not when it was typed in. Drives "3 months ago".
  reviewedAt DateTime @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isPublished, reviewedAt])
  @@index([isPublished])
}

/// A product saved to a user's wishlist. The composite key makes duplicates impossible.
model WishlistItem {
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

/// On-hand inventory for ONE sellable unit: a colour variant inside a product.
///
/// This is NOT a re-normalisation of variants — those stay in `Product.variants` JSON, and
/// `variantId`/`colorId` here are the ids from that JSON. Stock lives in its own table for two
/// reasons a JSON column cannot give: an atomic `quantity - reserved >= n` guarded UPDATE
/// (a JSON read-modify-write races under concurrent checkouts), and per-unit indexing.
///
/// A sellable unit with NO row here is "not tracked" and always sells — so adding this table
/// changes nothing until an admin sets a level.
model StockLevel {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  /// Product.variants[].id — a JSON id, not a foreign key.
  variantId String @db.VarChar(100)
  /// Product.variants[].colorVariants[].id — a JSON id, not a foreign key.
  colorId   String @db.VarChar(100)

  /// Physical units on hand.
  quantity Int @default(0)
  /// Units promised to pending orders. Sellable = quantity - reserved.
  reserved Int @default(0)
  /// At or below this (and above zero) the unit reports `low_stock`.
  lowStockThreshold Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, colorId])
  @@index([productId])
}

/// A message sent from the storefront contact form. Stored so enquiries survive the
/// WhatsApp hand-off — the customer's browser opening WhatsApp is not a record, and anything
/// sent while the business was offline used to be lost entirely.
model ContactEnquiry {
  id        String              @id @default(uuid()) @db.Uuid
  name      String              @db.VarChar(120)
  email     String              @db.VarChar(255)
  /// One of the form's fixed subject keys (order_issue, product_question, returns, other).
  subject   String              @db.VarChar(40)
  message   String
  status    ContactEnquiryStatus @default(NEW)
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([createdAt])
}

enum ContactEnquiryStatus {
  NEW
  READ
  RESOLVED
}

/// The four FIXED navigation categories. Never editable by the admin — they are a code
/// constant; only their Subcategories are managed.
enum CategoryType {
  GIFT_COMBOS
  SHOP_BY_OCCASION
  FLOWER
  BLUSHING_BLOOMS
}

/// A parent category. Categories are intentionally small: subcategory management only
/// needs a stable identifier, a display name, and an availability flag.
model Category {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique @db.VarChar(100)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)
  subcategories Subcategory[]
  giftGroups    GiftGroupCategory[]
}

/// A child of one Category. Keep this model deliberately narrow so every consumer uses
/// the same source of truth for its hover asset and status.
model Subcategory {
  id         String  @id @default(uuid()) @db.Uuid
  categoryId String  @db.Uuid
  name       String  @db.VarChar(100)
  /// Square-ish art for the circular nav strip and the Explore Gardens tile.
  hoverImage String?
  /// Wide art for the shop listing banner. Separate from hoverImage because the two are
  /// different shapes — a circular thumbnail stretched across a full-width hero looks wrong.
  /// Falls back to hoverImage when unset, so this is optional.
  bannerImage String?
  hoverColor String? @db.VarChar(50)
  isActive   Boolean @default(true)

  /// Visibility + order are per-section and deliberately independent:
  /// the category strip (nav) and the home "Explore Our Gardens" grid each have their own
  /// flag and their own position, so the same subcategory can be 5th in one and 1st in the other.
  /// `isExploreGarden` is the garden flag (kept under its original name).
  showInNavigation   Boolean @default(true)
  navigationPosition Int     @default(0)

  /// A "catch-all" entry such as "All Flowers": it holds no products of its own and instead
  /// links to the whole parent category. Without this it behaves like an ordinary (empty)
  /// subcategory and shows nothing when clicked.
  isCatchAll Boolean @default(false)
  isExploreGarden    Boolean @default(false)
  gardenPosition     Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products  Product[]

  @@unique([categoryId, name])
  @@index([categoryId, isActive])
  @@index([isExploreGarden, isActive])
  @@index([categoryId, showInNavigation, navigationPosition])
}

/// Editable content for the Blushing Blooms category page (/shop?category=blushing-blooms).
///
/// A singleton, guarded the same way DeliveryCharge / WelcomePopup / Occasion are: `singleton`
/// always defaults to true and carries a unique index, so a second row cannot be inserted even
/// under concurrent requests.
///
/// Every column is nullable on purpose. The storefront merges this row over the defaults in
/// lib/blushing-blooms.ts, so the page renders the designed content before an admin has ever
/// opened the form, and a cleared field falls back rather than rendering blank.
///
/// `heroMedia` / `bannerMedia` / `videoMedia` each hold ONE url that may be an image or a video.
/// Never branch on the file extension here — read them through isVideoMedia() in lib/media.ts,
/// which also handles Cloudinary urls that carry no extension at all.
model BlushingBloomsPage {
  id                   String   @id @default(uuid()) @db.Uuid

  heroMedia            String?
  heroTitle            String?  @db.VarChar(80)
  heroSubtitle         String?  @db.VarChar(400)

  bannerMedia          String?
  bannerEyebrow        String?  @db.VarChar(60)
  bannerTitle          String?  @db.VarChar(80)
  /// Rendered on its own line in the accent pink — the "speak from the heart" half.
  bannerTitleAccent    String?  @db.VarChar(80)
  bannerDescription    String?  @db.VarChar(400)
  bannerCtaLabel       String?  @db.VarChar(40)
  bannerCtaHref        String?  @db.VarChar(255)

  videoMedia           String?
  videoTitle           String?  @db.VarChar(80)
  /// Accent-pink half of the video heading, same treatment as bannerTitleAccent.
  videoTitleAccent     String?  @db.VarChar(80)
  videoDescription     String?  @db.VarChar(400)

  singleton            Boolean  @unique @default(true)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)
}

/// An admin-managed set of optional gifts offered for one or more subcategories.
/// Which gifts a product offers is resolved through GiftGroupCategory on the product's
/// subcategoryId — no category name or gift is ever hardcoded in application code.
model GiftGroup {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  description  String?
  isActive     Boolean  @default(true)
  /// Lowest value wins when a subcategory is covered by more than one group.
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  categories GiftGroupCategory[]
  gifts      Gift[]

  @@index([isActive, displayOrder])
}

/// Join table: one GiftGroup <-> many Categories (a Category may be covered by many groups).
/// Assigning a category offers the group's gifts on every product under it, across all of
/// that category's subcategories. Cascades delete the mapping rows only.
model GiftGroupCategory {
  id          String   @id @default(uuid()) @db.Uuid
  giftGroupId String   @db.Uuid
  categoryId  String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  giftGroup GiftGroup @relation(fields: [giftGroupId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // DB-level guarantee against assigning the same category to a group twice.
  @@unique([giftGroupId, categoryId])
  @@index([giftGroupId])
  @@index([categoryId])
}

/// One optional gift inside a GiftGroup. The price here is authoritative: the storefront
/// never decides what a gift costs — it is re-read from this row when the cart is priced.
model Gift {
  id           String   @id @default(uuid()) @db.Uuid
  giftGroupId  String   @db.Uuid
  name         String   @db.VarChar(120)
  price        Decimal  @db.Decimal(10, 2)
  /// Cloudinary secure URL, same as every other admin-uploaded image in this schema.
  image        String
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  giftGroup GiftGroup @relation(fields: [giftGroupId], references: [id], onDelete: Cascade)

  @@index([giftGroupId, isActive, displayOrder])
}
